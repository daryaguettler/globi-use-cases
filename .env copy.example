# host port (docker-compose.st.yml)
PORT=8502

# visualizer image name (ecr-style default in compose; override with env when pushing)
# AWS_ACCOUNT_ID=123456789012
# AWS_REGION=us-east-1

# python base image (docker/visualizer/Dockerfile)
# PYTHON_VERSION=3.12

# optional compose env_file overlays (same pattern as main globi repo; omit files if unused)
# AWS_ENV=local
# HATCHET_ENV=local
